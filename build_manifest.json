  "key_wiring": {
    "f1040_identity": [
      "f1040.first_name <- f1040_Federal_Info_Worksheet.taxpayer_first_name",
      "f1040.last_name <- f1040_Federal_Info_Worksheet.taxpayer_last_name",
      "f1040.ssn <- f1040_Federal_Info_Worksheet.taxpayer_ssn"
    ],
    "income_flows": [
      "f1040.1a <- sum(w2.*.box_1)",
      "f1040.2a <- sum(1099_int.*.box_8)",
      "f1040.2b <- sum(1099_int.*.box_1)",
      "f1040.3a <- sum(1099_div.*.box_1b)",
      "f1040.3b <- sum(1099_div.*.box_1a)",
      "f1040.6a <- f1040.social_security_benefits_total"
    ],
    "payment_flows": [
      "f1040.25 <- sum(w2.*.box_2) + federal_withholding_from_information_returns_total"
    ],
    "capital_gain_flows": [
      "f1040sd.1b <- f8949.1b",
      "f1040sd.2 <- f8949.2",
      "f1040sd.3 <- f8949.3",
      "f1040sd.8b <- f8949.8b",
      "f1040sd.9 <- f8949.9",
      "f1040sd.10 <- f8949.10",
      "f1040sd.13 <- f1040.capital_gain_distributions_total",
      "f1040sd.11 <- f1040.undistributed_long_term_capital_gains_total"
    ],
    "tax_resolution": [
      "f1040.16 <- f1040sd_Schedule_D_Tax.47 or f1040_Line_16_Qualified_Dividends_Capital_Gain_Tax.25 or f1040_Tax_Computation or f1040_Line_16_Foreign_Earned_Income_Tax.6"
    ]
  },
